APP_NAME="GM-Coaching"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Per-sender addresses (used by DynamicSystemMail templates)
# These appear as the "From" label in the recipient's inbox
# info@gm-coaching.com      → contact responses, system info
# bookings@gm-coaching.com  → bookings, payments, reminders
# passwordreset@gm-coaching.com → password resets, 2FA codes
MAIL_FROM_INFO=info@gm-coaching.com
MAIL_FROM_BOOKINGS=bookings@gm-coaching.com
MAIL_FROM_SECURITY=passwordreset@gm-coaching.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Paystack - https://dashboard.paystack.com/#/settings/keys
# TEST MODE: pk_test_xxx / sk_test_xxx / whsec_xxx
# LIVE MODE: pk_live_xxx / sk_live_xxx / whsec_xxx
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Sanctum - Comma-separated list of frontend domains that use cookie auth
# Local: localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
# Production: gm-coaching.com,www.gm-coaching.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

FRONTEND_URL=http://localhost:3000

VITE_APP_NAME="${APP_NAME}"
